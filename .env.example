# --- P0/P1 need just this one ---
NOTION_TOKEN=ntn_...         # the same integration token github-radar-ui uses
# Embeddings run locally (in-process ONNX, all-MiniLM-L6-v2, 384-dim) — no OpenAI key needed.

# --- P2: RAG /ask needs a Claude key (only /ask; /sync and /search work without it) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- P4: Langfuse tracing (optional; without keys tracing stays a local no-op) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com    # or https://us.cloud.langfuse.com / self-hosted
# LANGFUSE_OTLP_ENDPOINT=                     # full OTLP traces URL override; wins over LANGFUSE_HOST

# --- optional overrides (defaults live in application.yml) ---
# POSTGRES_URL=jdbc:postgresql://localhost:5432/radar
# POSTGRES_USER=radar
# POSTGRES_PASSWORD=radar
# TRENDING_DATA_SOURCE=f67aaa24-d5f2-415c-9358-c7d9d2f9713e
# LOOT_CLAUDE_DATA_SOURCE=8223d65e-4ed6-4a6e-b8ad-fb0c98c9a4ed
# LOOT_COPILOT_DATA_SOURCE=bafde792-70ff-4e07-9ffd-00ecf77f51be
# BLOG_DATA_SOURCE=d8e442b5-17c1-4e6f-a665-feb49d6e3099
