# --- P0/P1 need just this one ---
NOTION_TOKEN=ntn_...         # the same integration token github-radar-ui uses
# Embeddings run locally (in-process ONNX, paraphrase-multilingual-MiniLM-L12-v2, 384-dim; run
# scripts/fetch-models.sh once) — no OpenAI key needed.

# --- P2: RAG /ask needs a Claude key (only /ask; /sync and /search work without it) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# --- P4: Langfuse tracing (optional; without both keys nothing is exported) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# --- prod profile (the public deployment; see README "Prod profile") ---
# SPRING_PROFILES_ACTIVE=prod
# SYNC_SECRET=...           # required under prod: /sync wants `Authorization: Bearer $SYNC_SECRET`

# --- optional overrides (defaults live in application.yml) ---
# POSTGRES_URL=jdbc:postgresql://localhost:5432/radar
# POSTGRES_USER=radar
# POSTGRES_PASSWORD=radar
# TRENDING_DATA_SOURCE=f67aaa24-d5f2-415c-9358-c7d9d2f9713e
# NOTION_BASE_URL=https://api.notion.com/v1   # point at a local Notion stub for tests / evals
